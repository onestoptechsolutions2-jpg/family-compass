# ---------------------------------------------------------------------------
# Family Compass environment
# Copy to `.env` for local dev. On Coolify set these in the resource UI.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local dev against the compose Postgres:
DATABASE_URL="postgresql://familycompass:familycompass@localhost:5432/familycompass?schema=public"
# Compose sets these for the postgres container:
POSTGRES_USER="familycompass"
POSTGRES_PASSWORD="familycompass"
POSTGRES_DB="familycompass"

# --- Auth.js -----------------------------------------------------------------
# Generate: openssl rand -base64 33
AUTH_SECRET="change-me-in-production"
# Public origin of the app (no trailing slash).
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Required when running behind Coolify's reverse proxy.
AUTH_TRUST_HOST="true"

# --- OAuth providers (optional) --------------------------------------------
# https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (magic-link sign in + notifications) ---------------------------
# nodemailer connection string, e.g. smtp://user:pass@smtp.host:587
EMAIL_SERVER=""
EMAIL_FROM="Family Compass <no-reply@example.com>"

# --- App -----------------------------------------------------------------
# Comma-separated emails granted the platform admin role (payment verification).
ADMIN_EMAILS="you@example.com"
# Run prisma db seed automatically after migrate on boot (first deploy only).
RUN_SEED_ON_MIGRATE="false"
# Local: which host port to publish the app on.
APP_PORT="3000"
