# ---------------------------------------------------------------------------
# Family Compass environment — copy to `.env` for local dev.
# On Coolify, set these in the resource's Environment Variables instead.
# Nothing is hardcoded in the app; every value below is required or optional
# exactly as marked.
# ---------------------------------------------------------------------------

# --- Public origin (REQUIRED) ------------------------------------------------
# The externally reachable URL, no trailing slash. Used for share links,
# payment references and OAuth/redirect callbacks.
APP_URL="https://myroots.laitor.co.ke"
AUTH_URL="https://myroots.laitor.co.ke"
# Behind Coolify's reverse proxy:
AUTH_TRUST_HOST="true"
# Optional: force the origin used in links people RECEIVE (share pages,
# memorials, invites, WhatsApp sign-in). Leave unset in production — links then
# follow the live request host and fall back to APP_URL. Set it when developing
# locally but needing real shareable links, e.g. SHARE_ORIGIN="https://myroots.laitor.co.ke".
# SHARE_ORIGIN=""

# --- Ports (optional) ------------------------------------------------------
# PORT      = port the Next.js server listens on inside the container
# APP_PORT  = host port the container is published on (point your proxy /
#             domain at this). Set to whatever you forward, e.g. 9090.
PORT="3000"
APP_PORT="9090"

# --- Auth secret (REQUIRED) ------------------------------------------------
# openssl rand -base64 33
AUTH_SECRET=""

# --- Database (REQUIRED) --------------------------------------------------
# Compose service name is `postgres`; keep user/db in sync with DATABASE_URL.
POSTGRES_USER="familycompass"
POSTGRES_PASSWORD=""
POSTGRES_DB="familycompass"
DATABASE_URL="postgresql://familycompass:CHANGE_ME@postgres:5432/familycompass?schema=public"

# --- Sign-in --------------------------------------------------------------
# Primary onboarding is WhatsApp: relatives claim their own node on a shared
# view, the tree admin approves and sends a one-tap sign-in link over
# WhatsApp. Nothing below is required for that.
#
# Optional Google OAuth — redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional SMTP — only for the older email-invite flow.
EMAIL_SERVER=""
EMAIL_FROM=""

# --- M-Pesa Daraja / STK Push (optional) --------------------------------
# Leave blank to keep the manual "paste the code" flow. When all four of
# KEY/SECRET/SHORTCODE/PASSKEY are set AND an admin switches the provider to
# "mpesa_daraja" in Payment settings, checkout sends an STK prompt to the
# customer's phone and confirms automatically via the callback:
#   <APP_URL>/api/payments/webhook/mpesa_daraja
MPESA_ENV="sandbox"                       # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                        # Paybill, or the Till/store HO shortcode
MPESA_PASSKEY=""                          # Lipa na M-Pesa Online passkey
MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"   # or CustomerPayBillOnline

# --- Access control -----------------------------------------------------
# Comma-separated emails granted the platform-admin role on first sign-in.
ADMIN_EMAILS=""
# Bootstrap super-admin. `npm run db:seed` (or RUN_SEED_ON_MIGRATE) creates
# this user and prints a one-time sign-in link. Falls back to ADMIN_EMAILS[0].
SUPERADMIN_EMAIL=""
SUPERADMIN_NAME="Super Admin"
# Optional: also enable email+password sign-in for that admin (10+ chars).
# The one-time link still works as a fallback. Change it later in /account.
SUPERADMIN_PASSWORD=""
# There is NO in-app registration. By default only admins, existing users,
# invited people, and the allow-lists below may sign in. Flip OPEN_SIGNUP to
# true to let anyone sign in / self-provision.
OPEN_SIGNUP="false"
ALLOWED_SIGNUP_EMAILS=""          # e.g. alice@example.com,bob@example.com
ALLOWED_SIGNUP_DOMAINS=""         # e.g. laitor.co.ke  (whole domain)

# --- App -----------------------------------------------------------------
# The deploy always runs migrations + an idempotent seed (PaymentSettings +
# super-admin). Set to "true" only to skip the seed entirely.
SKIP_SEED="false"
