# ---------------------------------------------------------------------------
# Family Compass environment — copy to `.env` for local dev.
# On Coolify, set these in the resource's Environment Variables instead.
# Nothing is hardcoded in the app; every value below is required or optional
# exactly as marked.
# ---------------------------------------------------------------------------

# --- Public origin (REQUIRED) ------------------------------------------------
# The externally reachable URL, no trailing slash. Used for share links,
# payment references and OAuth/redirect callbacks.
APP_URL="https://myroots.laitor.co.ke"
AUTH_URL="https://myroots.laitor.co.ke"
# Behind Coolify's reverse proxy:
AUTH_TRUST_HOST="true"

# --- Ports (optional) ------------------------------------------------------
# PORT      = port the Next.js server listens on inside the container
# APP_PORT  = host port the container is published on (point your proxy /
#             domain at this). Set to whatever you forward, e.g. 9090.
PORT="3000"
APP_PORT="9090"

# --- Auth secret (REQUIRED) ------------------------------------------------
# openssl rand -base64 33
AUTH_SECRET=""

# --- Database (REQUIRED) --------------------------------------------------
# Compose service name is `postgres`; keep user/db in sync with DATABASE_URL.
POSTGRES_USER="familycompass"
POSTGRES_PASSWORD=""
POSTGRES_DB="familycompass"
DATABASE_URL="postgresql://familycompass:CHANGE_ME@postgres:5432/familycompass?schema=public"

# --- Sign-in method (need at least one) ---------------------------------------
# Google OAuth — redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email magic link — nodemailer connection string + a real From address.
# e.g. smtp://resend:re_xxx@smtp.resend.com:465
EMAIL_SERVER=""
EMAIL_FROM=""

# --- Access control -----------------------------------------------------
# Comma-separated emails granted the platform-admin role on first sign-in.
ADMIN_EMAILS=""
# There is NO in-app registration. By default only admins, existing users,
# invited people, and the allow-lists below may sign in. Flip OPEN_SIGNUP to
# true to let anyone sign in / self-provision.
OPEN_SIGNUP="false"
ALLOWED_SIGNUP_EMAILS=""          # e.g. alice@example.com,bob@example.com
ALLOWED_SIGNUP_DOMAINS=""         # e.g. laitor.co.ke  (whole domain)

# --- App -----------------------------------------------------------------
# Run `prisma db seed` after migrate on boot (first deploy only).
RUN_SEED_ON_MIGRATE="false"
