// Family Compass — data model
// Mirrors the Gramps core object model (Person / Family / Event / Place /
// Source / Citation / Repository / Note / Media / Tag) on top of a
// multi-tenant Workspace / Tree structure, plus sharing and paid chart
// generation.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Auth.js (v5) — Prisma adapter models
// ===========================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  passwordHash  String?
  image         String?

  // Data & research consent (see /policies). consentVersion tracks the policy
  // version the user last accepted; a bump re-prompts on next sign-in.
  consentVersion   String?
  consentAt        DateTime?
  researchConsent  Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  isPlatformAdmin Boolean @default(false)

  accounts Account[]
  sessions Session[]

  memberships          Membership[]
  invitationsSent      Invitation[]           @relation("InvitedBy")
  uploadedMedia        MediaObject[]          @relation("MediaUploader")
  generationJobs       GenerationJob[]        @relation("GenerationRequestedBy")
  payments             Payment[]              @relation("PaymentUser")
  paymentsVerified     Payment[]              @relation("PaymentVerifier")
  sharedViews          SharedView[]           @relation("SharedViewCreator")
  auditLogs            AuditLog[]
  activityEvents       ActivityEvent[]
  creditLedger         CreditLedger[]         @relation("CreditActor")
  claimedPerson        Person?                @relation("PersonClaimedBy")
  claimsDecided        PersonClaim[]          @relation("ClaimDecidedBy")
  claimsCreatedFor     PersonClaim[]          @relation("ClaimCreatedUser")
  claimInvitesCreated  ClaimInvite[]          @relation("ClaimInviteCreator")
  loginTokens          LoginToken[]
  deepSearches         DeepSearch[]           @relation("DeepSearchRequester")
  engagementsRequested ResearchEngagement[]   @relation("EngagementRequester")
  engagementsAssigned  ResearchEngagement[]   @relation("EngagementAssignee")
  consentEvents        ConsentEvent[]
  memorialsCreated     Memorial[]             @relation("MemorialCreator")
  memorialsLocked      Memorial[]             @relation("MemorialLocker")
  memorialInvites      MemorialContributor[]  @relation("MemorialContributorInviter")
  memorialReviews      MemorialContribution[] @relation("MemorialContributionReviewer")
  programEdits         FuneralProgram[]       @relation("ProgramEditor")
  programRevisions     ProgramRevision[]      @relation("ProgramReviser")
  notifications        Notification[]
  apiKeysCreated       ApiKey[]               @relation("ApiKeyCreator")
  webhooksCreated      WebhookEndpoint[]      @relation("WebhookCreator")
}

/// Immutable audit of consent actions (policy acceptance, research opt in/out).
model ConsentEvent {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  policyVersion String
  detail        String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===========================================================================
// Memorials (deceased-person tribute pages)
// ===========================================================================

enum GuestbookStatus {
  PENDING
  APPROVED
  HIDDEN
}

/// DRAFT → open editing + collecting contributions.
/// IN_REVIEW → contributions closed to new merges, family reviewing.
/// FINAL → locked; editing requires an explicit unlock by an editor.
enum MemorialStatus {
  DRAFT
  IN_REVIEW
  FINAL
}

enum ContributionStatus {
  SUBMITTED
  ACCEPTED
  DECLINED
}

/// A tribute page for a deceased person: eulogy, funeral program, guestbook,
/// and a shareable public link. Edits after publishing are audited.
model Memorial {
  id                 String   @id @default(cuid())
  personId           String   @unique
  treeId             String
  slug               String   @unique
  headline           String?
  eulogy             String?  @db.Text
  bornText           String?
  diedText           String?
  restingPlace       String?
  serviceText        String?  @db.Text
  coverMediaId       String?
  published          Boolean  @default(false)
  guestbookOpen      Boolean  @default(true)
  guestbookModerated Boolean  @default(true)
  includeLiving      Boolean  @default(true)
  createdById        String?
  viewCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // collaboration workflow
  status      MemorialStatus @default(DRAFT)
  lockedAt    DateTime?
  lockedById  String?
  finalisedAt DateTime?

  /// Public page look: classic | linkedin | stripe | x
  template String @default("classic")

  /// Biography-wizard answers the records can't supply (education, career,
  /// faith, character, interests, illness, last words, favourite scripture…).
  bioNotes Json?

  /// One shareable token (e.g. for a WhatsApp group) that lets anyone
  /// contribute memories to this memorial without a per-person invite.
  groupContribToken String? @unique

  person        Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  tree          Tree                   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  cover         MediaObject?           @relation("MemorialCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("MemorialCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lockedBy      User?                  @relation("MemorialLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  guestbook     GuestbookEntry[]
  flowers       MemorialFlower[]
  program       FuneralProgram?
  contributors  MemorialContributor[]
  contributions MemorialContribution[]

  @@index([treeId])
}

/// A relative invited to contribute to a memorial draft. Opens a tokenised
/// public link (typically shared over WhatsApp).
model MemorialContributor {
  id          String    @id @default(cuid())
  memorialId  String
  name        String
  phone       String?
  relation    String?
  token       String    @unique
  invitedById String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  memorial      Memorial               @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  invitedBy     User?                  @relation("MemorialContributorInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  contributions MemorialContribution[]

  @@index([memorialId])
}

/// A submitted piece of writing for a memorial (a memory, a tribute, a
/// correction). Reviewed by a tree editor before it is merged into the copy.
model MemorialContribution {
  id            String             @id @default(cuid())
  memorialId    String
  contributorId String?
  authorName    String
  section       String
  body          String             @db.Text
  status        ContributionStatus @default(SUBMITTED)
  reviewedById  String?
  reviewedAt    DateTime?
  mergedAt      DateTime?
  createdAt     DateTime           @default(now())

  memorial    Memorial             @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  contributor MemorialContributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  reviewedBy  User?                @relation("MemorialContributionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([memorialId, status])
}

model GuestbookEntry {
  id         String          @id @default(cuid())
  memorialId String
  name       String
  relation   String?
  message    String          @db.Text
  phone      String?
  status     GuestbookStatus @default(PENDING)
  ip         String?
  createdAt  DateTime        @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, status])
}

/// A light one-tap tribute anyone can leave on a public memorial — a flower,
/// a candle, a wreath. No message, minimal moderation (managers can hide one).
model MemorialFlower {
  id         String   @id @default(cuid())
  memorialId String
  kind       String   @default("flower")
  name       String?
  ip         String?
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, hidden, createdAt])
}

/// Order of service for the funeral. Every save snapshots a ProgramRevision.
model FuneralProgram {
  id          String    @id @default(cuid())
  memorialId  String    @unique
  venue       String?
  venueLat    Float?
  venueLng    Float?
  venueMapUrl String?
  serviceDate DateTime?
  committee   String?   @db.Text
  order       Json
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memorial  Memorial          @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("ProgramEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions ProgramRevision[]
}

model ProgramRevision {
  id         String   @id @default(cuid())
  programId  String
  editedById String?
  snapshot   Json
  note       String?
  createdAt  DateTime @default(now())

  program  FuneralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  editedBy User?          @relation("ProgramReviser", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([programId, createdAt])
}

/// Curated reference list of communities and clans (global). Tree-level `Clan`
/// records autocomplete from this and can cite a source.
model ReferenceClan {
  id         String  @id @default(cuid())
  community  String
  name       String
  normalized String
  aka        String?
  totem      String?
  region     String?
  notes      String? @db.Text
  source     String?

  @@unique([community, normalized])
  @@index([community])
  @@index([normalized])
}

/// One-time passwordless sign-in link (super-admin bootstrap, "email me a
/// link" style flows). Strictly single-use.
model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  purpose   String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================================================
// Tenancy
// ===========================================================================

enum Role {
  OWNER
  EDITOR
  CONTRIBUTOR
  VIEWER
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  exportCredits Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  trees          Tree[]
  payments       Payment[]
  pricingConfigs PricingConfig[]
  creditLedger   CreditLedger[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]

  @@index([slug])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(VIEWER)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([workspaceId, email])
  @@index([email])
}

model Tree {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  description      String?   @db.Text
  slug             String
  homePersonId     String?
  freeExportUsedAt DateTime?
  contactWhatsapp  String?
  claimPinHash     String?
  keeperUntil      DateTime?
  discoverable     Boolean   @default(false)
  community        String?
  region           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  people         Person[]
  families       Family[]
  events         Event[]
  places         Place[]
  sources        Source[]
  citations      Citation[]
  repositories   Repository[]
  notes          Note[]
  tags           Tag[]
  media          MediaObject[]
  sharedViews    SharedView[]
  generationJobs GenerationJob[]
  activityEvents ActivityEvent[]
  importJobs     ImportJob[]
  personClaims   PersonClaim[]
  claimInvites   ClaimInvite[]
  payments       Payment[]       @relation("TreePayments")
  clans          Clan[]
  memorials      Memorial[]

  @@unique([workspaceId, slug])
  @@index([discoverable])
}

/// African genealogy is clan-centric. A clan groups lineages/families; in most
/// Kenyan communities you don't marry within your own clan.
model Clan {
  id         String   @id @default(cuid())
  treeId     String
  name       String
  normalized String
  aka        String?
  community  String?
  totem      String?
  origin     String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tree   Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  people Person[]

  @@unique([treeId, normalized])
  @@index([normalized])
}

// ===========================================================================
// Genealogy core
// ===========================================================================

enum Gender {
  MALE
  FEMALE
  UNKNOWN
  OTHER
}

enum Privacy {
  INHERIT
  PUBLIC
  PRIVATE
}

enum DateModifier {
  NONE
  EXACT
  BEFORE
  AFTER
  ABOUT
  RANGE
  SPAN
}

enum DateQuality {
  NONE
  CALCULATED
  ESTIMATED
}

model Person {
  id              String   @id @default(cuid())
  treeId          String
  grampsId        String?
  gender          Gender   @default(UNKNOWN)
  living          Boolean  @default(false)
  privacy         Privacy  @default(INHERIT)
  phone           String?
  claimedByUserId String?  @unique
  clanId          String?
  subClan         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  claimedBy User? @relation("PersonClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  clan      Clan? @relation(fields: [clanId], references: [id], onDelete: SetNull)

  names        Name[]
  eventRefs    EventRef[]
  attributes   Attribute[]
  mediaRefs    MediaRef[]
  citationRefs CitationRef[]
  noteRefs     NoteRef[]

  familiesAsPartner1 Family[]   @relation("FamilyPartner1")
  familiesAsPartner2 Family[]   @relation("FamilyPartner2")
  childRefs          ChildRef[]

  centralOfSharedViews    SharedView[]    @relation("SharedViewCentral")
  centralOfGenerationJobs GenerationJob[] @relation("GenerationCentral")
  claims                  PersonClaim[]
  claimInvites            ClaimInvite[]
  memorial                Memorial?

  tags Tag[] @relation("PersonTags")

  @@unique([treeId, grampsId])
  @@index([treeId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A visitor to a public shared view asking to "be" an existing person
/// (personId set) or to be added to the tree (personId null). Verified out of
/// band over WhatsApp; approved by a tree editor.
model PersonClaim {
  id                   String      @id @default(cuid())
  treeId               String
  personId             String?
  claimantName         String
  phone                String
  note                 String?     @db.Text
  code                 String
  status               ClaimStatus @default(PENDING)
  signInToken          String?     @unique
  signInTokenExpiresAt DateTime?
  signInTokenUsedAt    DateTime?
  decidedById          String?
  decidedAt            DateTime?
  rejectionReason      String?     @db.Text
  createdUserId        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tree        Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  person      Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  decidedBy   User?   @relation("ClaimDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdUser User?   @relation("ClaimCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)

  @@index([treeId, status])
  @@index([code])
}

/// A tokenised "this is your profile — claim it" link that a tree editor
/// generates for a specific living, unclaimed person and sends (e.g. over
/// WhatsApp). The recipient opens /claim/<token> and files a PersonClaim.
model ClaimInvite {
  id          String    @id @default(cuid())
  treeId      String
  personId    String
  token       String    @unique
  note        String?   @db.Text
  createdById String?
  claimId     String?
  expiresAt   DateTime?
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tree      Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  person    Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ClaimInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([personId])
}

enum NameType {
  BIRTH
  MARRIED
  AKA
  NICKNAME
  IMMIGRANT
  MAIDEN
  UNKNOWN
}

model Name {
  id            String   @id @default(cuid())
  personId      String
  type          NameType @default(BIRTH)
  preferred     Boolean  @default(false)
  order         Int      @default(0)
  title         String?
  prefix        String?
  first         String?
  nick          String?
  callName      String?
  surnamePrefix String?
  surname       String?
  suffix        String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([surname])
}

enum FamilyType {
  MARRIED
  UNMARRIED
  CIVIL_UNION
  UNKNOWN
}

model Family {
  id         String     @id @default(cuid())
  treeId     String
  grampsId   String?
  partner1Id String?
  partner2Id String?
  type       FamilyType @default(UNKNOWN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tree     Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  partner1 Person? @relation("FamilyPartner1", fields: [partner1Id], references: [id], onDelete: SetNull)
  partner2 Person? @relation("FamilyPartner2", fields: [partner2Id], references: [id], onDelete: SetNull)

  childRefs    ChildRef[]
  eventRefs    EventRef[]
  attributes   Attribute[]
  mediaRefs    MediaRef[]
  citationRefs CitationRef[]
  noteRefs     NoteRef[]

  tags Tag[] @relation("FamilyTags")

  @@unique([treeId, grampsId])
  @@index([treeId])
  @@index([partner1Id])
  @@index([partner2Id])
}

enum ChildRelation {
  BIRTH
  ADOPTED
  STEPCHILD
  FOSTER
  SPONSORED
  UNKNOWN
}

model ChildRef {
  id               String        @id @default(cuid())
  familyId         String
  personId         String
  order            Int           @default(0)
  partner1Relation ChildRelation @default(BIRTH)
  partner2Relation ChildRelation @default(BIRTH)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([familyId, personId])
  @@index([personId])
}

model Event {
  id          String   @id @default(cuid())
  treeId      String
  grampsId    String?
  type        String
  description String?  @db.Text
  placeId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Structured Gramps-style date
  dateModifier DateModifier @default(NONE)
  dateQuality  DateQuality  @default(NONE)
  dateYear     Int?
  dateMonth    Int?
  dateDay      Int?
  dateYear2    Int?
  dateMonth2   Int?
  dateDay2     Int?
  dateText     String?
  dateSortKey  String?

  tree  Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  eventRefs    EventRef[]
  mediaRefs    MediaRef[]
  citationRefs CitationRef[]
  noteRefs     NoteRef[]
  attributes   Attribute[]

  @@unique([treeId, grampsId])
  @@index([treeId])
  @@index([placeId])
  @@index([dateSortKey])
}

enum EventRole {
  PRIMARY
  FAMILY
  WITNESS
  CELEBRANT
  INFORMANT
  CLERGY
  AIDE
  BRIDE
  GROOM
  UNKNOWN
}

model EventRef {
  id       String    @id @default(cuid())
  eventId  String
  personId String?
  familyId String?
  role     EventRole @default(PRIMARY)
  order    Int       @default(0)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([personId])
  @@index([familyId])
}

model Place {
  id           String   @id @default(cuid())
  treeId       String
  grampsId     String?
  title        String
  type         String?
  name         String?
  latitude     Float?
  longitude    Float?
  code         String?
  enclosedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tree       Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  enclosedBy Place?  @relation("PlaceHierarchy", fields: [enclosedById], references: [id], onDelete: SetNull)
  encloses   Place[] @relation("PlaceHierarchy")

  events    Event[]
  mediaRefs MediaRef[]
  noteRefs  NoteRef[]

  @@unique([treeId, grampsId])
  @@index([treeId])
}

model Source {
  id        String   @id @default(cuid())
  treeId    String
  grampsId  String?
  title     String
  author    String?
  pubInfo   String?
  abbrev    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  citations Citation[]
  repoRefs  RepoRef[]
  mediaRefs MediaRef[]
  noteRefs  NoteRef[]

  @@unique([treeId, grampsId])
  @@index([treeId])
}

model Citation {
  id         String   @id @default(cuid())
  treeId     String
  grampsId   String?
  sourceId   String
  page       String?
  confidence Int      @default(2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dateModifier DateModifier @default(NONE)
  dateQuality  DateQuality  @default(NONE)
  dateYear     Int?
  dateMonth    Int?
  dateDay      Int?
  dateText     String?

  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  refs      CitationRef[]
  mediaRefs MediaRef[]
  noteRefs  NoteRef[]

  @@unique([treeId, grampsId])
  @@index([treeId])
  @@index([sourceId])
}

model CitationRef {
  id         String  @id @default(cuid())
  citationId String
  personId   String?
  familyId   String?
  eventId    String?

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)
  person   Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  family   Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event    Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([citationId])
  @@index([personId])
  @@index([familyId])
  @@index([eventId])
}

model Repository {
  id        String   @id @default(cuid())
  treeId    String
  grampsId  String?
  name      String
  type      String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  repoRefs RepoRef[]
  noteRefs NoteRef[]

  @@unique([treeId, grampsId])
  @@index([treeId])
}

model RepoRef {
  id           String  @id @default(cuid())
  repositoryId String
  sourceId     String
  callNumber   String?
  mediaType    String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([sourceId])
}

enum NoteFormat {
  PLAIN
  HTML
}

model Note {
  id        String     @id @default(cuid())
  treeId    String
  grampsId  String?
  type      String?
  format    NoteFormat @default(PLAIN)
  text      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  refs NoteRef[]

  @@unique([treeId, grampsId])
  @@index([treeId])
}

model NoteRef {
  id           String  @id @default(cuid())
  noteId       String
  personId     String?
  familyId     String?
  eventId      String?
  placeId      String?
  sourceId     String?
  citationId   String?
  mediaId      String?
  repositoryId String?

  note       Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  person     Person?      @relation(fields: [personId], references: [id], onDelete: Cascade)
  family     Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event      Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place      Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  source     Source?      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citation   Citation?    @relation(fields: [citationId], references: [id], onDelete: Cascade)
  media      MediaObject? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  repository Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model Tag {
  id     String @id @default(cuid())
  treeId String
  name   String
  color  String @default("#6366f1")

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  people   Person[] @relation("PersonTags")
  families Family[] @relation("FamilyTags")

  @@unique([treeId, name])
  @@index([treeId])
}

model MediaObject {
  id           String   @id @default(cuid())
  treeId       String
  grampsId     String?
  fileName     String
  mimeType     String
  byteSize     Int
  bytes        Bytes
  checksum     String?
  width        Int?
  height       Int?
  thumbnail    Bytes?
  thumbMime    String?
  title        String?
  dateText     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  tree       Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  refs     MediaRef[]
  noteRefs NoteRef[]

  memorialCoverOf Memorial[]      @relation("MemorialCover")
  previewOfJobs   GenerationJob[] @relation("GenerationPreview")
  outputOfJobs    GenerationJob[] @relation("GenerationOutput")

  @@unique([treeId, grampsId])
  @@index([treeId])
}

model MediaRef {
  id         String  @id @default(cuid())
  mediaId    String
  personId   String?
  familyId   String?
  eventId    String?
  placeId    String?
  sourceId   String?
  citationId String?
  order      Int     @default(0)
  caption    String?
  rectX      Float?
  rectY      Float?
  rectW      Float?
  rectH      Float?

  media    MediaObject @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person   Person?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  family   Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event    Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place    Place?      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  source   Source?     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citation Citation?   @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([personId])
  @@index([familyId])
}

model Attribute {
  id       String  @id @default(cuid())
  personId String?
  familyId String?
  eventId  String?
  type     String
  value    String  @db.Text
  order    Int     @default(0)

  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([familyId])
  @@index([eventId])
}

// ===========================================================================
// Sharing
// ===========================================================================

enum ShareMode {
  PEDIGREE
  DESCENDANTS
  HOURGLASS
}

model SharedView {
  id              String    @id @default(cuid())
  treeId          String
  createdById     String
  slug            String    @unique
  title           String?
  centralPersonId String
  mode            ShareMode @default(HOURGLASS)
  generations     Int       @default(4)
  includeLiving   Boolean   @default(false)
  allowClaims     Boolean   @default(false)
  passwordHash    String?
  expiresAt       DateTime?
  revoked         Boolean   @default(false)
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tree          Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy     User   @relation("SharedViewCreator", fields: [createdById], references: [id])
  centralPerson Person @relation("SharedViewCentral", fields: [centralPersonId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([slug])
}

// ===========================================================================
// Import jobs
// ===========================================================================

enum ImportKind {
  GRAMPS_XML
  GEDCOM
}

enum ImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ImportJob {
  id        String       @id @default(cuid())
  treeId    String
  kind      ImportKind
  status    ImportStatus @default(QUEUED)
  fileName  String
  fileBytes Bytes
  report    Json?
  error     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([status])
}

// ===========================================================================
// Monetisation — paid chart / export generation
// ===========================================================================

enum GenerationKind {
  PEDIGREE_PDF
  FAN_CHART
  DESCENDANT_CHART
  FAMILY_BOOK
  MEMORIAL_BOOK
  GEDCOM_EXPORT
  GRAMPS_EXPORT
}

enum GenerationStatus {
  QUEUED
  RENDERING_PREVIEW
  PREVIEW_READY
  AWAITING_PAYMENT
  PAID
  RENDERING_OUTPUT
  OUTPUT_READY
  FAILED
}

model GenerationJob {
  id              String           @id @default(cuid())
  treeId          String
  requestedById   String
  kind            GenerationKind
  status          GenerationStatus @default(QUEUED)
  params          Json
  centralPersonId String?
  priceKes        Int
  nodeCount       Int?
  previewMediaId  String?
  outputMediaId   String?
  freeUnlock      Boolean          @default(false)
  unlockedAt      DateTime?
  error           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tree          Tree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  requestedBy   User         @relation("GenerationRequestedBy", fields: [requestedById], references: [id])
  centralPerson Person?      @relation("GenerationCentral", fields: [centralPersonId], references: [id], onDelete: SetNull)
  previewMedia  MediaObject? @relation("GenerationPreview", fields: [previewMediaId], references: [id], onDelete: SetNull)
  outputMedia   MediaObject? @relation("GenerationOutput", fields: [outputMediaId], references: [id], onDelete: SetNull)

  payment Payment?

  @@index([treeId])
  @@index([requestedById])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  AWAITING_STK
  AWAITING_VERIFICATION
  PAID
  REJECTED
  REFUNDED
  CANCELLED
}

enum PaymentKind {
  SINGLE
  BUNDLE_5
  BUNDLE_15
  KEEPER
  DEEP_SEARCH
  RESEARCH_PARTNER
}

model Payment {
  id                String        @id @default(cuid())
  generationJobId   String?       @unique
  workspaceId       String
  treeId            String?
  userId            String
  provider          String        @default("manual_mpesa")
  kind              PaymentKind   @default(SINGLE)
  creditsGranted    Int           @default(0)
  amountKes         Int
  currency          String        @default("KES")
  reference         String        @unique
  mpesaCode         String?
  payerPhone        String?
  payerNote         String?       @db.Text
  // Daraja STK Push (M-Pesa Express)
  checkoutRequestId String?       @unique
  merchantRequestId String?
  providerRef       String?
  resultCode        Int?
  resultDesc        String?
  status            PaymentStatus @default(PENDING)
  rejectionReason   String?       @db.Text
  verifiedById      String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  generationJob GenerationJob?      @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tree          Tree?               @relation("TreePayments", fields: [treeId], references: [id], onDelete: SetNull)
  user          User                @relation("PaymentUser", fields: [userId], references: [id])
  verifiedBy    User?               @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  ledgerEntries CreditLedger[]
  deepSearch    DeepSearch?         @relation("DeepSearchPayment")
  engagement    ResearchEngagement? @relation("EngagementPayment")

  @@index([workspaceId])
  @@index([treeId])
  @@index([userId])
  @@index([status])
  @@index([mpesaCode])
}

enum CreditReason {
  PURCHASE
  SPEND
  GRANT
  REFUND
  FREE
}

model CreditLedger {
  id              String       @id @default(cuid())
  workspaceId     String
  delta           Int
  balanceAfter    Int
  reason          CreditReason
  generationJobId String?
  paymentId       String?
  actorId         String?
  note            String?
  createdAt       DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  actor     User?     @relation("CreditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model PricingConfig {
  id          String         @id @default(cuid())
  workspaceId String?
  kind        GenerationKind
  priceKes    Int

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
}

enum VerificationMode {
  MANUAL
  AUTO_CODE
  WEBHOOK
}

// Single global row (scope = "global"). Holds the platform owner's M-Pesa
// Till / Store details and the swappable provider selection.
model PaymentSettings {
  id              String @id @default(cuid())
  scope           String @unique @default("global")
  provider        String @default("manual_mpesa")
  currency        String @default("KES")
  defaultPriceKes Int    @default(750)
  keeperPriceKes  Int    @default(3000)

  // Size-based print pricing: price = kind base
  //   + max(0, generations - freeGenerations) * perGenerationKes
  //   + max(0, nodeCount     - freeNodes)      * perNodeKes
  priceFreeGenerations  Int @default(4)
  priceFreeNodes        Int @default(60)
  pricePerGenerationKes Int @default(150)
  pricePerNodeKes       Int @default(8)

  // Cross-tree deep search (one paid lookup).
  deepSearchPriceKes Int @default(300)

  // Research Partner (we do the research): quote = base
  //   + perGeneration * generationsTarget + perNode * nodesTarget
  researchBaseKes          Int @default(5000)
  researchPerGenerationKes Int @default(1500)
  researchPerNodeKes       Int @default(200)

  tillNumber       String?
  storeNumber      String?
  paybillNumber    String?
  businessName     String?
  accountRef       String?
  instructions     String?          @db.Text
  verificationMode VerificationMode @default(MANUAL)
  config           Json?
  updatedAt        DateTime         @updatedAt
}

/// Base price per document type. Multipliers live on PaymentSettings.
model GenerationPricing {
  kind    GenerationKind @id
  baseKes Int            @default(750)
}

/// Reference administrative units for place autocomplete. Seeded starting with
/// Western Kenya (Luhya region), then Nyanza.
model KenyaLocation {
  id        String  @id @default(cuid())
  region    String
  county    String
  subcounty String?
  ward      String?
  path      String  @unique
  lat       Float?
  lng       Float?

  @@index([county])
  @@index([region])
}

/// A cross-tree lookup ("is this person from my bloodline / clan?").
model DeepSearch {
  id          String   @id @default(cuid())
  requesterId String
  query       Json
  resultCount Int      @default(0)
  status      String   @default("PREVIEW") // PREVIEW | PAID
  paymentId   String?  @unique
  createdAt   DateTime @default(now())

  requester User     @relation("DeepSearchRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  payment   Payment? @relation("DeepSearchPayment", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([requesterId])
}

enum EngagementStatus {
  REQUESTED
  QUOTED
  AWAITING_PAYMENT
  ACTIVE
  DELIVERED
  CLOSED
  CANCELLED
}

/// "Research Partner" — the platform (or a vetted researcher) is hired to build
/// a family/clan tree on the client's behalf. Priced per generation + per node.
model ResearchEngagement {
  id                String           @id @default(cuid())
  requestedById     String
  subjectName       String
  brief             String           @db.Text
  community         String?
  region            String?
  generationsTarget Int?
  nodesTarget       Int?
  status            EngagementStatus @default(REQUESTED)
  quotedKes         Int?
  quoteNote         String?          @db.Text
  paymentId         String?          @unique
  assignedToId      String?
  deliverableUrl    String?
  deliveryNote      String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  requestedBy User     @relation("EngagementRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  assignedTo  User?    @relation("EngagementAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  payment     Payment? @relation("EngagementPayment", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestedById])
}

// ===========================================================================
// Ops
// ===========================================================================

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  treeId      String?
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([treeId])
  @@index([actorId])
  @@index([createdAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  treeId     String
  actorId    String?
  verb       String
  objectType String
  objectId   String
  summary    String
  createdAt  DateTime @default(now())

  tree  Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([treeId, createdAt])
}

// ===========================================================================
// Notifications, API keys & outbound webhooks (integration surface)
// ===========================================================================

/// Internal per-user notification. Fed by the same domain events that drive
/// outbound webhooks. Delivery channel is in-app only for now; an email/SMS
/// fan-out can subscribe later without touching call sites.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  treeId      String?
  kind        String
  title       String
  body        String?
  linkPath    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A bearer key that grants a third-party integration scoped access to a
/// workspace through /api/v1. Only the SHA-256 of the key is stored.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  hashedKey   String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  createdById String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

/// A subscriber URL that receives signed POSTs when workspace events fire.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  workspaceId    String
  url            String
  secret         String
  events         String[]
  active         Boolean   @default(true)
  description    String?
  createdById    String?
  failureCount   Int       @default(0)
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  status      String    @default("PENDING")
  statusCode  Int?
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}
