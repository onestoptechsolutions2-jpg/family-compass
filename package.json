{
  "name": "family-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "fast-xml-parser": "^5.11.1",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.13.1",
    "pg-boss": "^12.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
